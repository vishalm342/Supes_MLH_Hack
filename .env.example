# Cloud model (OpenAI-compatible chat/completions endpoint)
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=

# Local Gemma
GEMMA_ENABLED=true            # set false on machines without the model; rules-only mode
GEMMA_MODEL_ALIAS=gemma-4-e2b-it

# Browser origins allowed to call the backend (comma-separated). The default allows the
# local web UI; Chrome extensions are allowed by CORS_ORIGIN_REGEX. Add http://<lan-ip>:3000
# when teammates open the UI from another machine.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=chrome-extension://[a-p]{32}

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
